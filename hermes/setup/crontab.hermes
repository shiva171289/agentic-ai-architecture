# Hermes VPS crontab — install with:  crontab hermes/setup/crontab.hermes
#
# NOTE: installing this file REPLACES the live crontab. Keep it the single source
# of truth for the schedule, and re-check `crontab -l` after any edit here.
#
# Times are UTC. The host runs Etc/UTC and this vintage of vixie cron ignores
# CRON_TZ, so a bare `45 6` is 06:45 UTC (12:15 IST), not 06:45 IST.

# cron's default PATH is /usr/bin:/bin, which has no ~/.local/bin — without this
# every `hermes` job dies with "/bin/sh: 1: hermes: not found".
PATH=/home/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin

0 6 * * * cd ~/work/agentic-ai-architecture && git pull --ff-only origin main >> ~/logs/git-pull.log 2>&1

30 6 * * 4 cd ~/work/agentic-ai-architecture && python3 hermes/tools/harvest_sources.py --days 14 >> ~/logs/harvest.log 2>&1

# Friday: scout + ADR + Telegram ADR gate (commits and pushes drafts/wNN first)
5 7 * * 5 cd ~/work/agentic-ai-architecture && python3 hermes/tools/weekly_pipeline.py friday-adr >> ~/logs/weekly-pipeline.log 2>&1

0 8 * * 1 cd ~/work/agentic-ai-architecture && hermes chat -q "Run the growth-analyst skill: produce this week's KPI nudge and topic steering." -s growth-analyst --oneshot >> ~/logs/growth.log 2>&1

15 8 * * 1 cd ~/work/agentic-ai-architecture && python3 hermes/tools/weekly_reminder.py >> ~/logs/weekly-reminder.log 2>&1

# News: daily harvest + summarize. --days 7 and dedupe-before-cap in
# news_ingest.py are both required, or supply drops to a trickle.
45 6 * * * cd ~/work/agentic-ai-architecture && python3 hermes/tools/harvest_sources.py --days 7 --json-out ~/.hermes/news-queue/harvest-latest.json >> ~/logs/news-harvest.log 2>&1 && python3 hermes/tools/news_ingest.py --max-per-publisher 4 >> ~/logs/news-ingest.log 2>&1 && python3 hermes/tools/news_summarize.py >> ~/logs/news-summarize.log 2>&1 && python3 hermes/tools/news_cleanup.py >> ~/logs/news-cleanup.log 2>&1

# Every 2 hours, not hourly: the feeds yield only ~15-20 qualifying items/day and
# an hourly pulse (24/day) drained the queue and logged 34 dry runs out of 95.
5 */2 * * * cd ~/work/agentic-ai-architecture && python3 hermes/tools/news_pulse_send.py >> ~/logs/news-pulse.log 2>&1

# Deliberately NOT scheduled: telegram_poll_approvals.py. Telegram allows one
# getUpdates consumer per bot and the Hermes gateway owns it, so that poller got
# HTTP 409 on every tick (1,464 consecutive failures) and never handled a single
# callback — the gate cards' inline buttons were dead. Approve by replying with
# the text command in the card ("adr approve wNN" / "publish approve wNN").
